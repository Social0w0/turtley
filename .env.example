PORT=3000

# 설정하면 PostgreSQL 에 저장 (Render 등 클라우드 배포 시 필수)
# Render: Postgres 대시보드의 "Internal Database URL" 을 붙여 넣기 (웹서비스와 같은 리전)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# SSL 강제 지정 (보통은 자동 판단: 내부 주소 = SSL 없음, 외부 주소 = SSL)
# PGSSL=require | disable

# DATABASE_URL 이 없을 때 쓰는 파일 경로 (로컬 개발용)
# DB_FILE=./data/db.json
